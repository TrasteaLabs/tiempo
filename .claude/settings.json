{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(./**/local.properties)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(~/.weatherapp/**)",
      "Bash(*local.properties*)",
      "Bash(*/.weatherapp*)",
      "PowerShell(*local.properties*)",
      "PowerShell(*/.weatherapp*)",
      "PowerShell(*\\.weatherapp*)",
      "Bash(adb * pm clear *)",
      "Bash(adb * uninstall *)",
      "Bash(*connectedAndroidTest*)",
      "PowerShell(*connectedAndroidTest*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(curl * | *sh)"
    ]
  },
  "enabledPlugins": {
    "becario@alvaro": true,
    "android-skills@android-skills": true
  }
}
